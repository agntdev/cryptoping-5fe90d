[
  {
    "name": "Settings",
    "steps": [
      {
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Settings\nTimezone: UTC\nQuiet hours: 23:00–07:00\nDaily summary: Off\nDefault cooldown: 4 hours"
            }
          }
        ],
        "send": {
          "callback": "settings:open"
        }
      }
    ]
  }
  ,{
    "name": "Set default cooldown",
    "steps": [
      { "send": { "callback": "settings:open" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "callback": "settings:cooldown" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Choose your default alert cooldown." } }] },
      { "send": { "callback": "settings:cooldown:12" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Your default cooldown is now 12 hours." } }] }
    ]
  }
]
