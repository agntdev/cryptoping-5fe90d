[
  {
    "name": "Add coin",
    "steps": [
      {
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Choose a coin to track."
            }
          }
        ],
        "send": {
          "callback": "addcoin:start"
        }
      }
    ]
  }
  ,{
    "name": "Add seeded coin and show it in the list",
    "steps": [
      { "send": { "callback": "addcoin:start" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Choose a coin to track." } }] },
      { "send": { "callback": "addcoin:BTC" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Bitcoin (BTC) is now in your list." } }] },
      { "send": { "callback": "watchlist:show:0" }, "expect": [{ "method": "editMessageText", "payload": { "text": "Your list (1)\nBitcoin (BTC)" } }] }
    ]
  }
]
